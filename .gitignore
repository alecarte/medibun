# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.js

# testing / coverage
coverage/

# turborepo
.turbo/

# next.js
.next/
out/

# production builds
build/
dist/

# expo / react native / metro
.expo/
.expo-shared/
*.orig.*
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/
android/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# source-system exports + import rejects (RECOVERY_DESIGN.md §7: raw exports are never
# committed, never uploaded — keep them outside the repo entirely; these rules are the
# backstop for when someone runs the importer from inside it anyway). No CSV is tracked
# today and test fixtures are composed in code, not checked in, so ignoring the whole
# extension costs nothing; committing one has to be a deliberate `git add -f`.
exports/
*.csv
*.rejects.csv

# local env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# claude code local state
.claude/scheduled_tasks.lock
.claude/worktrees/

# recovery artifacts — generated locally, practice-confidential; the backstop for when
# someone writes them from inside the repo anyway (same rule as exports/ and *.rejects.csv)
leak-report*.html
apps/api/config/*.json
!apps/api/config/service-categories.example.json
