{
  "color": {
    "$type": "color",
    "surface": {
      "canvas": { "$value": "{brand.color.background}" },
      "card": { "$value": "{color.paper}" },
      "well": { "$value": "{color.linen.100}" }
    },
    "text": {
      "primary": { "$value": "{brand.color.foreground}" },
      "secondary": { "$value": "{brand.color.muted}" },
      "on-accent": { "$value": "{brand.color.primary-contrast}" }
    },
    "border": {
      "hairline": { "$value": "{color.stone.200}" },
      "interactive": { "$value": "{color.stone.500}" }
    },
    "action": {
      "primary": { "$value": "{brand.color.primary}" }
    }
  }
}
