{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#FAFAF7" },
      "100": { "$value": "#F2F2EC" },
      "200": { "$value": "#E6E5DD" },
      "500": { "$value": "#85857A" },
      "600": { "$value": "#5D5D52" },
      "900": { "$value": "#1B1B16" }
    },
    "paper": { "$value": "#FFFFFF" },
    "status": {
      "success": {
        "text": { "$value": "#3F6B3D" },
        "wash": { "$value": "#E8F0E7" }
      },
      "warning": {
        "text": { "$value": "#8F5A10" },
        "wash": { "$value": "#F7EDDC" }
      },
      "danger": {
        "text": { "$value": "#A63A2A" },
        "wash": { "$value": "#F8E4E0" }
      },
      "info": {
        "text": { "$value": "#2F6D73" },
        "wash": { "$value": "#E2EEEF" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "sheet": { "$value": "24px" },
    "full": { "$value": "9999px" }
  },
  "elevation": {
    "$type": "string",
    "low": { "$value": "0 1px 2px rgba(27, 27, 22, 0.05)" },
    "mid": { "$value": "0 2px 8px rgba(27, 27, 22, 0.06)" },
    "high": { "$value": "0 12px 32px rgba(27, 27, 22, 0.1)" }
  },
  "motion": {
    "$type": "string",
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "feature": { "$value": "600ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)" }
    }
  },
  "font": {
    "$type": "string",
    "family": {
      "display": { "$value": "Instrument Sans" },
      "text": { "$value": "Instrument Sans" },
      "data": { "$value": "Fragment Mono" }
    },
    "size": {
      "kicker": { "$value": "12px" },
      "body-sm": { "$value": "14px" },
      "body": { "$value": "16px" },
      "title-sm": { "$value": "20px" },
      "title": { "$value": "24px" },
      "display-sm": { "$value": "32px" },
      "display": { "$value": "44px" }
    },
    "weight": {
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" }
    },
    "leading": {
      "text": { "$value": "1.55" },
      "compact": { "$value": "1.35" },
      "display": { "$value": "1.15" }
    },
    "tracking": {
      "kicker": { "$value": "0.04em" },
      "display": { "$value": "-0.01em" }
    }
  }
}
