{
  "brand": {
    "name": { "$type": "string", "$value": "Handal" },
    "logo": {
      "$type": "string",
      "$description": "Asset reference (URL or bundle key) resolved per platform, not hardcoded.",
      "$value": "/brand/handal-logo.svg"
    },
    "color": {
      "$type": "color",
      "$description": "PLACEHOLDER brand values: surgical register on the same sleek-neutral system — deep palm accent, cooler near-white, tighter radius.",
      "primary": { "$value": "#2E4B3F" },
      "primary-contrast": { "$value": "#FFFFFF" },
      "background": { "$value": "#FAFAFA" },
      "foreground": { "$value": "#1B1C1A" },
      "muted": { "$value": "{color.neutral.600}" },
      "wash": { "$value": "#E4EAE3" },
      "glow": { "$value": "#EFF2EE" }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "{radius.sm}" }
    },
    "font": {
      "$type": "string",
      "display-settings": { "$value": "normal" }
    }
  }
}
