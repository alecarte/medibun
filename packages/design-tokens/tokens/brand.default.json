{
  "brand": {
    "name": { "$type": "string", "$value": "Default" },
    "logo": {
      "$type": "string",
      "$description": "Asset reference (URL or bundle key) resolved per platform, not hardcoded.",
      "$value": "/brand/default-logo.svg"
    },
    "color": {
      "$type": "color",
      "primary": { "$value": "#6941c6" },
      "primaryContrast": { "$value": "#ffffff" },
      "background": { "$value": "{color.white}" },
      "foreground": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.500}" }
    }
  }
}
