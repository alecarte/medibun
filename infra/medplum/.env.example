# Written by infra/medplum/setup-dev.sh (or fill manually from the app UI).
# LOCAL DEV ONLY — never commit real values; never use real PHI against this instance.

# Local self-hosted Medplum server (trailing slash required).
MEDPLUM_BASE_URL=http://localhost:8103/

# ClientApplication credentials (OAuth2 client-credentials).
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Bot id created by setup-dev.sh (used by the verify:subscription script).
MEDPLUM_BOT_ID=

# Project the BFF authenticates app users into (written by setup-dev.sh). REQUIRED for auth:
# apps/api gates the auth routes on MEDPLUM_PROJECT_ID + EXPERIENCE_DATABASE_URL +
# SESSION_ENCRYPTION_KEY — if any is unset, /auth/* and /patients/me silently 404.
MEDPLUM_PROJECT_ID=

# Experience DB (local dev: the experience-postgres compose service; prod: Neon per ADR-0002).
EXPERIENCE_DATABASE_URL=postgres://medibun:medibun@localhost:5433/medibun_experience

# Session-token encryption key (AES-256-GCM), 32 bytes base64. Generate: openssl rand -base64 32
# LOCAL DEV ONLY here — prod key lives in the secret manager, never in any file.
SESSION_ENCRYPTION_KEY=

# Cookies are Secure by default; local http dev must opt out explicitly.
API_COOKIE_INSECURE_DEV=1
# Browser origins allowed on mutating auth routes (comma-separated, EXACT match). Empty = none.
# Dev defaults: the portal (3100) and staff (3200) apps — see their package.json dev scripts —
# in both localhost and 127.0.0.1 spellings (browsers send whichever is in the address bar).
API_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200,http://127.0.0.1:3100,http://127.0.0.1:3200
# Set to 1 ONLY behind a proxy that overwrites x-real-ip (e.g. Vercel) — never for
# direct traffic, where the header is client-controlled.
API_TRUST_PROXY=
