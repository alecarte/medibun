# Metro (Expo) cannot resolve pnpm's default symlinked/isolated node_modules,
# so use a hoisted layout for the whole workspace.
node-linker=hoisted

# The React Native / Expo ecosystem has chronically loose, conflicting peer
# ranges; strict mode would block installs. Pin React/RN explicitly instead.
strict-peer-dependencies=false

# Keep the catalog authoritative — fail installs that bypass it.
# (pnpm 11 enforces this when versions are declared as "catalog:".)
auto-install-peers=true
