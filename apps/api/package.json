{
  "name": "@medibun/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../infra/medplum/.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../infra/medplum/.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@medibun/api-client": "workspace:*",
    "@medibun/fhir-types": "workspace:*",
    "@medibun/medplum-backend": "workspace:*",
    "hono": "catalog:",
    "@hono/node-server": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "tsx": "^4.19.0",
    "drizzle-kit": "catalog:",
    "@types/pg": "catalog:",
    "@electric-sql/pglite": "catalog:"
  }
}
